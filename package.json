{
  "name": "crocbox",
  "version": "1.0.0-beta.3",
  "description": "CROCbox — The Agent Trust Layer for OpenClaw",
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "dev": "electron . --dev"
  },
  "keywords": [
    "openclaw",
    "card",
    "trust-layer",
    "agent-economy",
    "consent"
  ],
  "author": "Openly Personal Networks, Inc. (Opn.li)",
  "license": "SEE LICENSE IN LICENSE",
  "dependencies": {
    "dotenv": "^16.4.0",
    "ws": "^8.19.0"
  },
  "devDependencies": {
    "electron": "^33.0.0"
  },
  "engines": {
    "node": ">=22.0.0"
  },
  "build": {
    "appId": "com.opnli.crocbox",
    "productName": "CROCbox",
    "mac": {
      "category": "public.app-category.utilities",
      "icon": "assets/CROCbox.icns",
      "target": [
        "dmg"
      ],
      "identity": "BA63999CD184C59C7BCEB2B44DFCC0E026A9ABC5",
      "hardenedRuntime": true,
      "gatekeeperAssess": false,
      "notarize": false
    },
    "dmg": {
      "title": "CROCbox v${version}",
      "icon": "assets/CROCbox.icns",
      "iconSize": 80,
      "window": {
        "width": 540,
        "height": 380
      },
      "contents": [
        {
          "x": 140,
          "y": 190
        },
        {
          "x": 400,
          "y": 190,
          "type": "link",
          "path": "/Applications"
        }
      ]
    },
    "files": [
      "main.js",
      "preload.js",
      "ws-proxy.js",
      "shield-score.js",
      "card_ve_client.js",
      "bigcroc-workspace.js",
      "green-shield-gate.js",
      "package.json",
      "Trust.md",
      "node_modules/**/*"
    ],
    "extraResources": [
      {
        "from": "assets/CROCbox.icns",
        "to": "CROCbox.icns"
      },
      {
        "from": "bundled-openclaw.tar.gz",
        "to": "bundled-openclaw.tar.gz"
      },
      {
        "from": "Trust.md",
        "to": "Trust.md"
      }
    ]
  }
}
