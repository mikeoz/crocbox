# ============================================================================
# CROCbox Configuration
# ============================================================================
# Copy this file to .env and fill in your values.
# ============================================================================

# ── OpenClaw Gateway ───────────────────────────────────────────────
# Where the OpenClaw gateway is running (default: local)
OPENCLAW_HOST=127.0.0.1
OPENCLAW_PORT=18789

# ── CARD Proxy ─────────────────────────────────────────────────────
# Port the CARD Proxy listens on (sits in front of OpenClaw)
CROCBOX_PROXY_PORT=18790

# ── Verification Endpoint ──────────────────────────────────────────
# URL and API key for the CARD Verification Endpoint
VERIFY_CARD_URL=https://ehsnrqjyvtluwkmizsyy.supabase.co/functions/v1/verify-card
VERIFY_API_KEY=da1ec57bdb55e55068f9722fd1cd195f1df62466205eff5cfce408ff089297a4

# ── Agent Identity ─────────────────────────────────────────────────
# The CARD agent URN (from the Entity CARD instance)
CROCBOX_AGENT_ID=urn:uuid:5b3a4df1-d71b-4e8c-9c6d-22f12a95c358

# ── Consent ────────────────────────────────────────────────────────
# How long to wait for user consent before blocking (milliseconds)
# Default: 300000 (5 minutes)
CROCBOX_CONSENT_TIMEOUT=300000

# ── Dashboard ──────────────────────────────────────────────────────
# Port for the CROCbox web dashboard
CROCBOX_DASHBOARD_PORT=3000

# ── Logging ────────────────────────────────────────────────────────
# Directory for audit logs
CROCBOX_LOG_DIR=./logs

# ── Supabase (Consumer Shell) ──────────────────────────────────────
# Lovable-managed Supabase instance — used by the Consumer Shell
# for Auth, CARD RPCs, and data queries. The anon key is publishable
# and scoped by RLS policies.
SUPABASE_URL=https://ehsnrqjyvtluwkmizsyy.supabase.co
SUPABASE_ANON_KEY=sb_publishable_ku9GsVckF8Lpk_JiPstDzg_rYXedkdz


# ── AI Service ─────────────────────────────────────────────────
AI_PROVIDER=anthropic
AI_API_KEY=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
